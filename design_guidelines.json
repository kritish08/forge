{
  "brand_identity": {
    "name": "FORGE",
    "tagline": "Consistency forged in fire",
    "ethos": "Discipline, Heat, Transformation. No fluff, just results.",
    "aesthetic_mode": "Light Theme with High-Heat Accents",
    "visual_keywords": ["Industrial Clean", "White Hot", "Molten Orange", "Ash Grey", "Precision"]
  },
  "typography": {
    "font_family": {
      "headings": "Chivo, sans-serif",
      "body": "Manrope, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "scale": {
      "h1": "text-4xl md:text-5xl font-black tracking-tight",
      "h2": "text-3xl font-bold tracking-tight",
      "h3": "text-2xl font-bold",
      "body": "text-base font-medium leading-relaxed",
      "caption": "text-sm text-muted-foreground uppercase tracking-widest"
    },
    "imports": [
      "@import url('https://fonts.googleapis.com/css2?family=Chivo:wght@300;400;700;900&family=Manrope:wght@400;500;700&family=JetBrains+Mono:wght@400&display=swap');"
    ]
  },
  "colors": {
    "palette": {
      "primary": {
        "DEFAULT": "#F97316",
        "foreground": "#FFFFFF",
        "50": "#FFF7ED",
        "100": "#FFEDD5",
        "500": "#F97316",
        "600": "#EA580C",
        "900": "#7C2D12"
      },
      "secondary": {
        "DEFAULT": "#52525B",
        "foreground": "#FAFAFA",
        "100": "#F4F4F5",
        "900": "#18181B"
      },
      "background": "#FFFFFF",
      "surface": "#FAFAFA",
      "border": "#E4E4E7",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444"
    },
    "usage": {
      "brand_gradient": "bg-gradient-to-br from-orange-500 to-red-600",
      "text_gradient": "bg-clip-text text-transparent bg-gradient-to-r from-orange-600 to-red-600",
      "subtle_bg": "bg-orange-50/50"
    }
  },
  "layout_strategies": {
    "spacing": {
      "container_padding": "p-6 md:p-8 lg:p-12",
      "element_gap": "gap-4 md:gap-6",
      "section_gap": "gap-12 md:gap-24"
    },
    "grid_system": {
      "dashboard": "grid grid-cols-1 md:grid-cols-12 gap-6",
      "bento_cards": "grid grid-cols-1 md:grid-cols-3 gap-4"
    },
    "mobile_nav": {
      "position": "fixed bottom-0 left-0 right-0",
      "style": "bg-white/80 backdrop-blur-xl border-t border-border/40 pb-safe z-50",
      "height": "h-16"
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90 rounded-sm font-bold uppercase tracking-wide shadow-[0_4px_14px_0_rgba(249,115,22,0.39)] transition-all active:scale-95",
      "secondary": "bg-secondary text-secondary-foreground hover:bg-secondary/90 rounded-sm font-medium",
      "outline": "border-2 border-primary text-primary hover:bg-orange-50 rounded-sm font-bold uppercase",
      "ghost": "hover:bg-accent hover:text-accent-foreground rounded-sm"
    },
    "cards": {
      "base": "bg-white border border-border/60 shadow-sm rounded-lg hover:shadow-md transition-shadow duration-300",
      "interactive": "cursor-pointer hover:border-orange-200 hover:shadow-[0_0_20px_rgba(249,115,22,0.1)] transition-all duration-300 group",
      "glass": "bg-white/70 backdrop-blur-xl border border-white/20 shadow-lg"
    },
    "inputs": {
      "style": "bg-white border-input ring-offset-background focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-md h-12"
    }
  },
  "visual_enhancers": {
    "shadows": {
      "glow": "shadow-[0_0_15px_rgba(249,115,22,0.5)]",
      "clean": "shadow-sm"
    },
    "borders": {
      "subtle": "border border-zinc-100",
      "highlight": "border-l-4 border-orange-500"
    },
    "textures": {
      "noise": "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E\")"
    }
  },
  "motion": {
    "micro_interactions": {
      "hover_lift": "hover:-translate-y-1 transition-transform duration-300",
      "click_squish": "active:scale-95 transition-transform duration-100"
    },
    "animations": {
      "check_off": "animate-in zoom-in-50 duration-300 ease-spring-4",
      "streak_fire": "animate-pulse text-orange-500",
      "page_enter": "animate-in fade-in slide-in-from-bottom-4 duration-500 ease-out"
    }
  },
  "image_assets": {
    "hero_background": {
