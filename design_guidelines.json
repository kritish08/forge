      "alt": "Abstract orange smoke on white",
      "usage": "Use as a subtle background texture for the Hero section or Onboarding splash screen with low opacity (10-20%)."
    },
    "coach_strategic": {
      "url": "https://images.unsplash.com/photo-1754300681803-61eadeb79d10?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTY2NzR8MHwxfHNlYXJjaHwxfHxtaW5pbWFsaXN0JTIwM2QlMjBnb2xkJTIwdHJvcGh5JTIwYXdhcmQlMjBpY29uJTIwd2hpdGUlMjBiYWNrZ3JvdW5kfGVufDB8fHx8MTc3MjIxNDgwMnww&ixlib=rb-4.1.0&q=85",
      "alt": "Golden Chess Queen",
      "usage": "Avatar for the 'Strategic' AI Coach mode."
    },
    "coach_supportive": {
      "url": "https://images.unsplash.com/photo-1755029553373-87246d245ec1?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDQ2MzR8MHwxfHNlYXJjaHwxfHxtaW5pbWFsaXN0JTIwYWJzdHJhY3QlMjBvcmFuZ2UlMjBmaXJlJTIwc21va2UlMjB3aGl0ZSUyMGJhY2tncm91bmR8ZW58MHx8fHwxNzcyMjE0ODAxfDA&ixlib=rb-4.1.0&q=85",
      "alt": "Warm Sunset Glow",
      "usage": "Avatar or background theme for the 'Supportive' AI Coach mode."
    },
    "achievement_trophy": {
      "url": "https://images.unsplash.com/photo-1645513966570-d59a97f62a44?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTY2NzR8MHwxfHNlYXJjaHwyfHxtaW5pbWFsaXN0JTIwM2QlMjBnb2xkJTIwdHJvcGh5JTIwYXdhcmQlMjBpY29uJTIwd2hpdGUlMjBiYWNrZ3JvdW5kfGVufDB8fHx8MTc3MjIxNDgwMnww&ixlib=rb-4.1.0&q=85",
      "alt": "Golden Statue Trophy",
      "usage": "Use for the 'Achievements' or 'Level Up' modal."
    }
  },
  "library_recommendations": {
    "charts": "Recharts (Shadcn Charts wrapper)",
    "icons": "Lucide React (default)",
    "toasts": "Sonner",
    "animations": "Framer Motion (for complex transitions) or Tailwind Animate (for simple ones)",
    "calendar": "Shadcn Calendar (react-day-picker)"
  },
  "universal_guidelines": [
    "Do not use generic centered layouts. Use asymmetry to create tension.",
    "Use 2-3x more spacing than typical designs (p-8, p-12).",
    "Every interaction needs micro-animations.",
    "Dark colors look good when used independently without gradients.",
    "Use glass-morphism effects with backdrop filters (12-24px blur) for sticky navs.",
    "Never use 'Inter' for headings. Use 'Chivo'.",
    "All interactive elements MUST include data-testid attributes.",
    "Mobile images max-height 80vh.",
    "Use Lucide icons for UI, Phosphor icons for marketing if needed.",
    "Ensure 4.5:1 contrast ratio for normal text."
  ],
  "instructions_to_main_agent": {
    "setup": [
      "Install required fonts: Chivo, Manrope via Google Fonts import in index.css.",
      "Update tailwind.config.js with the new color palette (Primary: Orange-500).",
      "Override default Shadcn radius to 0.3rem or 0.5rem (slightly sharper).",
      "Ensure 'sonner' is installed for toasts."
    ],
    "implementation_order": [
      "1. Layout & Navigation (Mobile Bottom Bar)",
      "2. Dashboard (Habit List + Heatmap)",
      "3. AI Coach Interface",
      "4. Analytics & Gamification"
    ],
    "critical_files": [
      "/app/frontend/src/index.css",
      "/app/frontend/tailwind.config.js",
      "/app/frontend/src/App.js"
    ]
  }
}